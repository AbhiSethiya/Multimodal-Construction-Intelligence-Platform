*.py[cod]
*$py.class
*.so
.Python
backend/__pycache__/
backend/*/__pycache__/
backend/*/*/__pycache__/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
